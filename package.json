{
  "name": "bulk-order-coop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --names app,api \"vite dev\" \"wrangler pages dev build --port 8787\"",
    "dev:app": "vite dev",
    "dev:api": "wrangler pages dev build --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:integration:watch": "vitest --config vitest.config.integration.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "e2e:serve": "wrangler pages dev build/ --port 4173 --persist-to .wrangler/state-e2e --binding JWT_SECRET=test-e2e-secret --binding RESEND_API_KEY=re_xxx",
    "e2e:migrate": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state-e2e",
    "test:all": "bun run test && bun run test:integration && bun run test:e2e",
    "format": "oxfmt && prettier --write \"**/*.svelte\"",
    "format:check": "oxfmt --check . && prettier --check \"**/*.svelte\"",
    "lint": "oxlint . --ignore-path .gitignore && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:check": "bun scripts/migrate.ts --check"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "bits-ui": "^2.16.2",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.3",
    "idb": "^8.0.3",
    "nanoid": "^5.1.6",
    "pdfjs-dist": "^5.6.205"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260228.1",
    "@hono/node-server": "^1.19.9",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^25.3.3",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.9",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "0.43.0",
    "oxlint": "^1.50.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.69.0"
  }
}
